# ── PowerSync self-hosted (be_ruta/powersync) ────────────────────────────────
# Copia a `.env` y rellena. `.env` está gitignorado.

# Puerto expuesto del servicio PowerSync (el cliente web se conecta aquí).
PS_PORT=8080

# FUENTE: el MISMO MongoDB Atlas que usa be_ruta. Copia MONGODB_URI de be_ruta/.env.
# Debe ser un replica set (Atlas lo es) para que funcionen los change streams.
PS_MONGO_SOURCE_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/ruta?retryWrites=true&w=majority

# BUCKET STORAGE: Postgres interno de PowerSync (lo levanta el compose). No tocar
# salvo que cambies credenciales del servicio `bucket-storage`.
PS_STORAGE_URI=postgresql://powersync:powersync@bucket-storage:5432/powersync

# AUTH — audiencia (claim `aud`) del token PowerSync que emite be_ruta.
PS_JWT_AUDIENCE=powersync

# RS256 (activo en service.yaml): URL del JWKS de be_ruta. PowerSync la consulta
# para validar el token. host.docker.internal = el host donde corre be_ruta.
# Requiere POWERSYNC_JWT_PRIVATE_KEY en be_ruta/.env (ver README).
PS_JWKS_URI=http://host.docker.internal:3000/auth/jwks

# Arranque rápido HS256 (secreto compartido, no recomendado): base64url del
# JWT_SECRET de be_ruta. Solo si vuelves service.yaml al bloque jwks. Generar con:
#   printf '%s' "$JWT_SECRET" | basenc --base64url | tr -d '='
# PS_JWT_SECRET_B64URL=
