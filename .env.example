# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Convención v2 mientras conviven ambos sistemas: BE v2 en 3002 y FE v2 en 3001
# (el be_ruta del sistema anterior ocupa el 3000).
PORT=3002

# Orígenes permitidos para CORS y socket.io, separados por coma.
# En v2 el navegador habla DIRECTO con este backend (ya no hay BFF de Next).
CORS_ORIGINS=http://localhost:3001

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# Todo el esquema vive en el schema `ruta`, NUNCA en `public`. Ver
# `src/database/database.module.ts` para el porqué. Antes de la primera corrida:
#   pnpm db:bootstrap    (crea el schema; `pnpm migration:run` ya lo encadena)
#   pnpm db:check-schema (verifica que no se coló nada en `public`)
#
# Desarrollo: Postgres local del docker compose.
DATABASE_URL=postgresql://ruta:ruta@localhost:5432/ruta
#
# Supabase — usa el POOLER, no `db.<ref>.supabase.co`: la conexión directa es
# IPv6-only salvo que contrates el add-on de IPv4. Ojo con el usuario: contra el
# pooler es `postgres.<ref>`, no `postgres` a secas, o responde
# «Tenant or user not found». `sslmode=require` es obligatorio, y basta ponerlo
# en la URL: el driver lo lee de ahí (no hace falta configurar `ssl` en código).
#
#   Runtime (transaction pooler, 6543):
#   DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
#   Migraciones (session pooler, 5432) — el transaction pooler NO conserva los
#   parámetros de arranque de los que depende `data-source.ts`:
#   DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Si la contraseña trae caracteres especiales, va URL-encoded (@ → %40, # → %23).

# Conexión remota a Supabase (opcional). Se deja declarada para réplicas,
# lecturas remotas o migración de datos. Vacía = deshabilitada.
# OJO: hoy NINGÚN módulo la consume; para apuntar a Supabase se cambia
# DATABASE_URL. Ver `src/config/env.schema.ts`.
SUPABASE_DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Cache de perfil/permisos. Si no responde, el cache degrada con gracia.
REDIS_URL=redis://localhost:6379

# ── Autenticación ─────────────────────────────────────────────────────────────
# Firma los access tokens (JWT). Generar con: openssl rand -base64 32
JWT_SECRET=cambia-este-secreto-min-16-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Bootstrap del super admin (seed de un solo uso, opcionales)
CEDULA_SUPER_ADMIN=
PASSWORD_SUPER_ADMIN=

# ── Cifrado SiScout (se mantienen del sistema anterior) ───────────────────────
# Generar con: openssl rand -base64 32
SISCOUT_BASE_URL=
SISCOUT_ENCRYPTION_KEY=
SISCOUT_CREDENTIALS_KEY=
CEDULA_HASH_KEY=

# ── Correo transaccional (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=https://ruta.scout.org.co
