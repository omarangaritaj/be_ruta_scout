# Todas las variables se declaran y validan en src/config/env.schema.ts

# Entorno de ejecución. Opcional — por defecto: development
# Valores admitidos: development | production | test
NODE_ENV=development

# Puerto en el que escucha la API. Opcional — por defecto: 3000
PORT=3000

# REQUERIDA. Cadena de conexión a MongoDB (incluye el nombre de la base).
# Local:  mongodb://localhost:27017/ruta
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ruta?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ruta

# --- Integración con SiScout (secretos y conexión) ---
# SiScout no es una API REST: es una app Laravel con login por formulario y
# endpoints DataTables. Sin estas variables la app arranca igual y la
# sincronización queda deshabilitada.
#
# Los AJUSTES OPERATIVOS (zonas, tamaños de página y de lote, cron e
# interruptor) NO están aquí: son configuración editable en tiempo de ejecución
# en la colección `siscout_config`, accesible por GET/PATCH /siscout/config.
# En el entorno solo viven los secretos y la conexión.

# URL base, p. ej. https://colombia.siscout.org
SISCOUT_BASE_URL=

# Cuenta maestra nacional. Solo servidor, nunca se expone al cliente.
SISCOUT_MASTER_USER=
SISCOUT_MASTER_PASSWORD=

# Ruta que activa el perfil con acceso nacional. Se obtiene inspeccionando la
# página de selección de roles en el primer login.
# Ejemplo: /users/change-rol/826/176035/7
SISCOUT_CHANGE_ROL_PATH=

# Clave AES-256 para cifrar los campos sensibles del snapshot en reposo.
# Generar con: openssl rand -base64 32
SISCOUT_ENCRYPTION_KEY=
