# Todas las variables se declaran y validan en src/config/env.schema.ts

# Entorno de ejecución. Opcional — por defecto: development
# Valores admitidos: development | production | test
NODE_ENV=development

# Puerto en el que escucha la API. Opcional — por defecto: 3000
PORT=3000

# REQUERIDA. Cadena de conexión a MongoDB (incluye el nombre de la base).
# Local:  mongodb://localhost:27017/ruta
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ruta?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ruta

# --- Integración con SiScout (claves y conexión) ---
# SiScout no es una API REST: es una app Laravel con login por formulario y
# endpoints DataTables. Sin estas variables la app arranca igual y la
# sincronización queda deshabilitada.
#
# Aquí solo viven la CONEXIÓN y las CLAVES DE CIFRADO. Lo demás es editable en
# tiempo de ejecución:
#   - Ajustes operativos (zonas, páginas, lotes, cron, interruptor):
#     colección `siscout_config` — GET/PATCH /siscout/config
#   - Credenciales (usuario, contraseña cifrada, ruta de cambio de rol y
#     alcance): colección `siscout_credentials` — /siscout/credentials
#
# El pool de credenciales arranca VACÍO. La primera se da de alta por API:
#
#   curl -X POST localhost:3000/siscout/credentials \
#     -H 'Content-Type: application/json' \
#     -d '{"nombre":"nacional","usuario":"...","password":"...",
#          "changeRolPath":"/users/change-rol/826/176035/7",
#          "alcance":{"tipo":"nacional"}}'

# URL base, p. ej. https://colombia.siscout.org
SISCOUT_BASE_URL=

# --- Claves de cifrado (AES-256) ---
# Generar con: openssl rand -base64 32
#
# Admiten UNA clave suelta o VARIAS con identificador, separadas por comas y
# con la activa primero:
#
#   SISCOUT_ENCRYPTION_KEY=<clave>                     # forma simple
#   SISCOUT_ENCRYPTION_KEY=v2:<nueva>,v1:<anterior>    # tras rotar
#
# Al rotar se cifra con la primera y se sigue leyendo lo escrito con las
# demás. La clave anterior NO se borra hasta que ya no queden documentos
# cifrados con ella. Una clave suelta equivale a `v1:<clave>`.

# Cifra los campos sensibles del snapshot: cédula, teléfono y correo.
SISCOUT_ENCRYPTION_KEY=

# Cifra las contraseñas del pool de credenciales. DISTINTA de la anterior a
# propósito: filtrar una no debe comprometer la otra.
SISCOUT_CREDENTIALS_KEY=

# Clave del HMAC de búsqueda por cédula (formato keyring, igual que las de
# cifrado). No cifra: solo permite buscar una cédula sin descifrarla.
CEDULA_HASH_KEY=

# --- Autenticación (Passport + JWT) ---
# Firma los access tokens. Generar con: openssl rand -base64 48
# Si falta, la app no arranca (la autenticación no puede operar).
JWT_SECRET=

# Vida del access token (formato de `ms`/jsonwebtoken). Opcional — por defecto: 15m
JWT_ACCESS_TTL=15m

# Vida del refresh token en días. Opcional — por defecto: 30
JWT_REFRESH_TTL_DAYS=30
